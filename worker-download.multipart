--c265c72aa53845cb0511ea93461c01959086134d0d79c5b1c90b311be1d0
Content-Disposition: form-data; name="worker/index.js"

// Single Cloudflare Worker entrypoint: serves the static app shell and every
// /api/* route. Replaces the old api/ folder (Azure Functions) entirely.
//
// Security layers (2026-09-30):
//  1. Only the app page and its logos are public (PUBLIC_ASSETS below; .assetsignore
//     also keeps everything else out of the upload). Data exports, docs, scripts,
//     logs and server code in the repo are never served.
//  2. Every response gets browser security headers (CSP, no framing, no sniffing,
//     HTTPS-only, no referrer leaks); API responses are never cached.
//  3. State-changing API calls must come from this site (Origin check) -- on top of
//     the SameSite=Strict session cookie.
//  4. Logins lock out after repeated failures (routes/auth-routes.js).
import { handleGet, handlePost } from "./routes/data.js";
import { handleUpload } from "./routes/upload.js";
import { handleAuditExport } from "./routes/audit-export.js";
import { handleLogin, handleLogout, handleMe } from "./routes/auth-routes.js";
import { handleGetUsers, handlePostUsers, handleTeam } from "./routes/users.js";
import { handleGetSignoffs, handlePostSignoff, handlePostSignoffTasks, handleSignoffStats } from "./routes/signoffs.js";
import { handleExtras, handlePn } from "./routes/pnotes.js";
import { readFile } from "./kvClient.js";
import { requireSession } from "./auth.js";

// Photos and PDFs open in the browser instead of downloading as raw bytes.
const ATT_TYPES = {
  ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".png": "image/png", ".gif": "image/gif", ".webp": "image/webp",
  ".pdf": "application/pdf", ".txt": "text/plain", ".csv": "text/csv",
};

const PUBLIC_ASSETS = new Set([
  "/apa_app_shell", "/apa_app_shell.html",
  "/logo2.jpg", "/logo1.png", "/Logo.png", "/Logo-transparent.png", "/logo2-transparent.png",
]);

const CSP = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com",
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  "font-src https://fonts.gstatic.com",
  "img-src 'self' data: blob:",
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'none'",
  "form-action 'self'",
  "frame-ancestors 'none'",
].join("; ");

function secure(resp, isApi) {
  const r = new Response(resp.body, resp);
  const h = r.headers;
  h.set("Content-Security-Policy", CSP);
  h.set("X-Frame-Options", "DENY");
  h.set("X-Content-Type-Options", "nosniff");
  h.set("Referrer-Policy", "no-referrer");
  h.set("Strict-Transport-Security", "max-age=31536000; includeSubDomains");
  h.set("Permissions-Policy", "camera=(), microphone=(), geolocation=(), payment=(), usb=()");
  h.set("Cross-Origin-Opener-Policy", "same-origin");
  if (isApi) h.set("Cache-Control", "no-store");
  return r;
}

function json(status, body) {
  return new Response(JSON.stringify(body), { status, headers: { "Content-Type": "application/json" } });
}

function errorResponse(e) {
  return json(e.status || 500, { error: e.message || "Server error" });
}

async function route(request, env, url) {
  const path = url.pathname;
  const method = request.method;

  // Writes must come from this site (blocks cross-site form/fetch attacks).
  if ((path.startsWith("/api/") || path.startsWith("/attachments/")) && method !== "GET" && method !== "HEAD") {
    const origin = request.headers.get("Origin");
    if (origin && origin !== url.origin) return json(403, { error: "Cross-site request blocked." });
  }

  // --- auth ---
  if (path === "/api/login" && method === "POST") return handleLogin(request, env);
  if (path === "/api/logout" && method === "POST") return handleLogout(request, env);
  if (path === "/api/me" && method === "GET") return handleMe(request, env);
  if (path === "/api/team" && method === "GET") return handleTeam(request, env);
  if (path === "/api/signoffs" && method === "GET") return handleGetSignoffs(request, env, url);
  if (path === "/api/signoffs/stats" && method === "GET") return handleSignoffStats(request, env, url);
  if (path === "/api/signoffs" && method === "POST") return handlePostSignoff(request, env);
  if (path === "/api/signoff-tasks" && method === "POST") return handlePostSignoffTasks(request, env);
  if (path === "/api/extras.js" && method === "GET") return handleExtras(request, env);
  if (path === "/api/pn") return handlePn(request, env);

  // --- generic entity data (leads/providers/notifications/audit/accepted-insurances/training/hiring/tasks) ---
  // "users" is special-cased to the dedicated admin-only handlers (routes/users.js)
  // rather than the generic create/update/delete in routes/data.js, since it needs
  // password hashing and must never return password hashes to the client.
  let m = path.match(/^\/api\/data\/([\w-]+)$/);
  if (m && m[1] === "users" && method === "GET") return handleGetUsers(request, env);
  if (m && m[1] === "users" && method === "POST") return handlePostUsers(request, env);
  if (m && method === "GET") return handleGet(request, env, m[1]);
  if (m && method === "POST") return handlePost(request, env, m[1]);

  // --- attachments ---
  m = path.match(/^\/api\/upload\/([\w.-]+)$/);
  if (m && method === "POST") return handleUpload(request, env, m[1]);

  if (path === "/api/audit/export" && method === "GET") return handleAuditExport(request, env);
  if (path.startsWith("/api/")) return json(404, { error: "not found" });

  m = path.match(/^\/attachments\/([\w.-]+)\/([\w.-]+)$/);
  if (m && method === "GET") {
    await requireSession(request, env);   // LOAs and provider photos are for signed-in staff only
    const bytes = await readFile(env, m[1], m[2]);
    if (!bytes) return json(404, { error: "not found" });
    const ext = (m[2].match(/\.[a-z0-9]+$/i) || [""])[0].toLowerCase();
    return new Response(bytes, { status: 200, headers: {
      "Content-Type": ATT_TYPES[ext] || "application/octet-stream", "Cache-Control": "private, max-age=86400" } });
  }

  // apa_app_shell.html is the single source of truth for the frontend, served at "/".
  // Requested extension-less (the assets binding redirects "/apa_app_shell.html" there anyway).
  if (path === "/" || path === "/index.html") {
    const shellUrl = new URL(request.url);
    shellUrl.pathname = "/apa_app_shell";
    const resp = await env.ASSETS.fetch(new Request(shellUrl, request));
    return new Response(resp.body, {
      status: resp.status,
      headers: { "Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-cache" },
    });
  }

  // --- everything else: only the allow-listed public files ---
  if ((method === "GET" || method === "HEAD") && PUBLIC_ASSETS.has(path)) return env.ASSETS.fetch(request);
  return new Response("Not found", { status: 404, headers: { "Content-Type": "text/plain" } });
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const isApi = url.pathname.startsWith("/api/") || url.pathname.startsWith("/attachments/");
    let resp;
    try {
      resp = await route(request, env, url);
    } catch (e) {
      resp = errorResponse(e);
    }
    return secure(resp, isApi);
  },
};

--c265c72aa53845cb0511ea93461c01959086134d0d79c5b1c90b311be1d0
Content-Disposition: form-data; name="worker/kvClient.js"

// Thin wrapper around Workers KV -- the only "backend" this app has, mirroring
// the interface of the old api/shared/blobClient.js (Azure Blob Storage)
// almost exactly, so the route logic ported from Azure Functions barely
// changes. Every JSON entity (leads / providers / notifications / audit /
// accepted-insurances / training / users) is one KV key holding the whole
// array as its value. No database, no ORM.

const ALLOWED_ENTITIES = new Set([
  "leads", "providers", "notifications", "audit", "accepted-insurances", "training", "users", "hiring", "tasks", "insdir",
]);

function assertEntity(entity) {
  if (!ALLOWED_ENTITIES.has(entity)) {
    const err = new Error("Unknown data entity: " + entity);
    err.status = 400;
    throw err;
  }
}

async function readJson(env, entity) {
  assertEntity(entity);
  const raw = await env.APA_KV.get(entity);
  return raw ? JSON.parse(raw) : [];
}

async function writeJson(env, entity, data) {
  assertEntity(entity);
  await env.APA_KV.put(entity, JSON.stringify(data));
}

// "leads" is split into two KV keys instead of one, since almost every save
// is a note/status/attachment/insurance edit -- not a name/contact-info
// change -- and rewriting the whole ~900KB record set for a one-line note
// was the actual cause of slow saves. Rarely-edited fields stay in
// "leads_static"; frequently-edited fields live in the much smaller
// "leads_dynamic", which is the only thing a normal edit rewrites.
const LEADS_DYNAMIC_FIELDS = new Set([
  "st", "sd", "sa", "sh", "grp", "attachments", "notesLog", "insurance", "deleted",
]);

function splitLeadRecord(record) {
  const dynamic = { i: record.i };
  const staticPart = { i: record.i };
  for (const k of Object.keys(record)) {
    if (k === "i") continue;
    if (LEADS_DYNAMIC_FIELDS.has(k)) dynamic[k] = record[k];
    else staticPart[k] = record[k];
  }
  return { staticPart, dynamic };
}

function mergeLeads(staticList, dynamicList) {
  const dynByI = new Map(dynamicList.map((d) => [String(d.i), d]));
  return staticList.map((s) => Object.assign({}, s, dynByI.get(String(s.i)) || {}));
}

// Raw blobs for GET /api/data/leads: passed straight through (the browser
// merges them), so the Worker never parses/re-serialises ~1.5 MB of JSON --
// keeps the read comfortably inside the free plan's per-request CPU budget.
async function readLeadsRaw(env) {
  return Promise.all([env.APA_KV.get("leads_static"), env.APA_KV.get("leads_dynamic")]);
}

async function readLeads(env) {
  const [staticRaw, dynamicRaw] = await Promise.all([
    env.APA_KV.get("leads_static"),
    env.APA_KV.get("leads_dynamic"),
  ]);
  const staticList = staticRaw ? JSON.parse(staticRaw) : [];
  const dynamicList = dynamicRaw ? JSON.parse(dynamicRaw) : [];
  return mergeLeads(staticList, dynamicList);
}

// Full rewrite of both blobs -- used for create/delete and any update that
// touches a static (rarely-edited) field. Rare enough that the double write
// doesn't matter.
async function writeLeadsSplit(env, mergedList) {
  const staticList = [];
  const dynamicList = [];
  for (const record of mergedList) {
    const { staticPart, dynamic } = splitLeadRecord(record);
    staticList.push(staticPart);
    dynamicList.push(dynamic);
  }
  await Promise.all([
    env.APA_KV.put("leads_static", JSON.stringify(staticList)),
    env.APA_KV.put("leads_dynamic", JSON.stringify(dynamicList)),
  ]);
}

// Fast path for the common case: a patch made up only of dynamic fields
// (status, notes, attachments, insurance, soft-delete) rewrites only the
// small "leads_dynamic" blob -- the static blob is never read or touched.
function isLeadsDynamicOnlyPatch(patch) {
  return Object.keys(patch).every((k) => k === "i" || LEADS_DYNAMIC_FIELDS.has(k));
}

async function writeLeadsDynamicPatch(env, id, patch, beforeWrite) {
  const raw = await env.APA_KV.get("leads_dynamic");
  const dynamicList = raw ? JSON.parse(raw) : [];
  let idx = dynamicList.findIndex((d) => String(d.i) === String(id));
  if (idx === -1) {
    // leads added straight to leads_static (bulk imports) get their overlay entry on first edit
    const s = (await env.APA_KV.get("leads_static")) || "";
    const num = /^\d+$/.test(String(id)) && s.indexOf('{"i":' + id + ",") !== -1;
    if (!num && s.indexOf('{"i":' + JSON.stringify(String(id)) + ",") === -1) return false;
    dynamicList.push({ i: num ? Number(id) : String(id) }); idx = dynamicList.length - 1;
  }
  if (beforeWrite) beforeWrite(dynamicList[idx]);   // sees the stored values before they change (audit wording)
  dynamicList[idx] = Object.assign({}, dynamicList[idx], patch, { i: id });
  await env.APA_KV.put("leads_dynamic", JSON.stringify(dynamicList));
  return true;
}

// Sign-off audit entries: one small key per agent per day ("audit-so:<date>:<agent>"), the same layout as the sign-offs
// themselves, so a busy main audit list (read-modify-write) can never drop them.
async function appendSignoffAudit(env, date, agent, entry) {
  const key = "audit-so:" + date + ":" + encodeURIComponent(agent);
  const raw = await env.APA_KV.get(key);
  const list = raw ? JSON.parse(raw) : [];
  list.push(Object.assign({ id: cryptoRandomId() }, entry, { timestamp: entry.timestamp || new Date().toISOString() }));
  await env.APA_KV.put(key, JSON.stringify(list));
}
// The full audit trail: the main list plus every sign-off audit key.
async function readAuditAll(env) {
  const main = await readJson(env, "audit");
  let keys = [];
  for (const prefix of ["audit-d:", "audit-so:"]) {
    let cursor;
    do {
      const page = await env.APA_KV.list({ prefix, cursor });
      keys = keys.concat(page.keys.map((k) => k.name)); cursor = page.list_complete ? null : page.cursor;
    } while (cursor);
  }
  const parts = await Promise.all(keys.map((k) => env.APA_KV.get(k)));
  return main.concat(...parts.map((r) => (r ? JSON.parse(r) : [])));
}

// Every audit entry is stored in a small per-person-per-day key ("audit-d:<date>:<user>"). The old single "audit" list was
// rewritten on every save, and with KV's up-to-60s replication two saves in the same minute could silently drop entries.
// The old list is kept read-only as history.
async function appendAudit(env, entry) {
  const key = "audit-d:" + new Date().toISOString().slice(0, 10) + ":" + encodeURIComponent(entry.user || "system");
  const raw = await env.APA_KV.get(key);
  const list = raw ? JSON.parse(raw) : [];
  list.push(Object.assign({ id: cryptoRandomId() }, entry, { timestamp: new Date().toISOString() }));
  await env.APA_KV.put(key, JSON.stringify(list));
}

function cryptoRandomId() {
  return Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 10);
}

// File bytes for lead attachments, keyed as "attachments:{leadId}:{filename}".
// Kept in the same KV namespace (no R2) so the whole stack stays on services
// confirmed free with no card on file.
async function uploadFile(env, leadId, filename, arrayBuffer) {
  const key = "attachments:" + leadId + ":" + filename;
  await env.APA_KV.put(key, arrayBuffer);
  return "/attachments/" + leadId + "/" + filename;
}

async function readFile(env, leadId, filename) {
  const key = "attachments:" + leadId + ":" + filename;
  return env.APA_KV.get(key, "arrayBuffer");
}

export {
  readJson, writeJson, appendAudit, appendSignoffAudit, readAuditAll, uploadFile, readFile, cryptoRandomId, ALLOWED_ENTITIES,
  readLeads, readLeadsRaw, writeLeadsSplit, isLeadsDynamicOnlyPatch, writeLeadsDynamicPatch,
};

--c265c72aa53845cb0511ea93461c01959086134d0d79c5b1c90b311be1d0
Content-Disposition: form-data; name="worker/routes/audit-export.js"

// Ported from api/audit-export/index.js, unchanged logic. Admin-only (new --
// the Azure version had no role tiers; this app now does for Audit/Users).
import { readAuditAll } from "../kvClient.js";
import { requireAdmin } from "../auth.js";

function csvEscape(v) {
  const s = String(v == null ? "" : v);
  return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
}

async function handleAuditExport(req, env) {
  await requireAdmin(req, env);
  const url = new URL(req.url);
  const from = url.searchParams.get("from") ? new Date(url.searchParams.get("from")) : null;
  const to = url.searchParams.get("to") ? new Date(url.searchParams.get("to")) : null;
  const who = url.searchParams.get("user") || "";   // optional: only this person's actions
  const log = await readAuditAll(env);
  const rows = log.filter((r) => {
    const t = new Date(r.timestamp);
    if (from && t < from) return false;
    if (to && t > to) return false;
    if (who && r.user !== who) return false;
    return true;
  });
  const headers = ["timestamp", "user", "entity", "entityId", "action", "summary"];
  const lines = [headers.join(",")].concat(rows.map((r) => headers.map((h) => csvEscape(r[h])).join(",")));
  return new Response(lines.join("\n"), {
    status: 200,
    headers: { "Content-Type": "text/csv", "Content-Disposition": "attachment; filename=audit-export.csv" },
  });
}

export { handleAuditExport };

--c265c72aa53845cb0511ea93461c01959086134d0d79c5b1c90b311be1d0
Content-Disposition: form-data; name="worker/routes/auth-routes.js"

// New: replaces Azure Static Web Apps' built-in /.auth/me + x-ms-client-
// principal with a custom email+password login, since Cloudflare Access
// would require a card on file.
import { readJson } from "../kvClient.js";
import {
  getSession, signSession, verifyPassword,
  sessionCookieHeader, clearSessionCookieHeader, SESSION_TTL_SECONDS,
} from "../auth.js";

// Brute-force protection: 5 wrong passwords for an account, or 10 failed attempts from
// one IP, lock sign-in for 15 minutes. Counters live in KV with a 15-minute expiry and
// stop being written once locked, so an attacker can't burn the free KV write quota.
const LOCK_MINUTES = 15;
const MAX_PER_ACCOUNT = 5;
const MAX_PER_IP = 10;

async function readCounter(env, key) {
  return (await env.APA_KV.get(key, "json")) || { n: 0 };
}
async function bump(env, key, c) {
  await env.APA_KV.put(key, JSON.stringify({ n: c.n + 1 }), { expirationTtl: LOCK_MINUTES * 60 });
}
function locked() {
  return new Response(JSON.stringify({ error: "Too many failed sign-in attempts. Try again in " + LOCK_MINUTES + " minutes." }),
    { status: 429, headers: { "Retry-After": String(LOCK_MINUTES * 60) } });
}

async function handleLogin(req, env) {
  const body = await req.json().catch(() => ({}));
  const email = String(body.email || "").trim().toLowerCase();
  const password = String(body.password || "");
  if (!email || !password) {
    return new Response(JSON.stringify({ error: "Email and password are required." }), { status: 400 });
  }
  const ip = req.headers.get("CF-Connecting-IP") || "unknown";
  const ipKey = "lockout:ip:" + ip, acctKey = "lockout:acct:" + email;
  const [ipC, acctC] = await Promise.all([readCounter(env, ipKey), readCounter(env, acctKey)]);
  if (ipC.n >= MAX_PER_IP || acctC.n >= MAX_PER_ACCOUNT) return locked();
  const users = await readJson(env, "users");
  const user = users.find((u) => !u.deleted && String(u.email || "").toLowerCase() === email);
  if (!user || !(await verifyPassword(password, user.passwordHash, user.salt))) {
    const writes = [bump(env, ipKey, ipC)];
    if (user) writes.push(bump(env, acctKey, acctC));   // only real accounts get a counter
    await Promise.all(writes);
    return new Response(JSON.stringify({ error: "Incorrect email or password." }), { status: 401 });
  }
  if (acctC.n > 0) await env.APA_KV.delete(acctKey);
  const exp = Math.floor(Date.now() / 1000) + SESSION_TTL_SECONDS;
  const token = await signSession({ uid: user.id, name: user.name, role: user.role, exp }, env.SESSION_SECRET);
  return new Response(JSON.stringify({ ok: true, name: user.name, role: user.role, uid: user.id }), {
    status: 200,
    headers: { "Content-Type": "application/json", "Set-Cookie": sessionCookieHeader(token, SESSION_TTL_SECONDS) },
  });
}

async function handleLogout(req, env) {
  return new Response(JSON.stringify({ ok: true }), {
    status: 200,
    headers: { "Content-Type": "application/json", "Set-Cookie": clearSessionCookieHeader() },
  });
}

async function handleMe(req, env) {
  const session = await getSession(req, env);
  if (!session) return new Response(JSON.stringify({ signedIn: false }), { status: 200 });
  return new Response(JSON.stringify({ signedIn: true, name: session.name, role: session.role, uid: session.uid }), {
    status: 200, headers: { "Content-Type": "application/json" },
  });
}

export { handleLogin, handleLogout, handleMe };

--c265c72aa53845cb0511ea93461c01959086134d0d79c5b1c90b311be1d0
Content-Disposition: form-data; name="worker/routes/data.js"

// Ported from api/data-get/index.js + api/data-save/index.js (Azure Functions).
// Business logic, validation, and audit-summary text are unchanged -- only
// the storage calls now go through kvClient (Workers KV) instead of
// blobClient (Azure Blob Storage), and admin-only gating is added for the
// "audit" entity (new -- Azure version had no role tiers).
import {
  readJson, writeJson, appendAudit, readAuditAll,
  readLeads, readLeadsRaw, writeLeadsSplit, writeLeadsDynamicPatch,
} from "../kvClient.js";
import { requireSession, requireAdmin } from "../auth.js";

const ID_FIELD = { leads: "i", providers: "id", notifications: "id", training: "id", hiring: "id", tasks: "id", insdir: "id" };

async function handleGet(req, env, entity) {
  if (entity === "audit") {
    await requireAdmin(req, env);
  } else {
    await requireSession(req, env);
  }
  if (entity === "leads") {
    // Both KV blobs are stitched together as strings (no JSON.parse/stringify);
    // the browser merges static + dynamic by id.
    const [s, d] = await readLeadsRaw(env);
    return new Response('{"split":1,"s":' + (s || "[]") + ',"d":' + (d || "[]") + "}", {
      status: 200, headers: { "Content-Type": "application/json" },
    });
  }
  const data = entity === "audit" ? await readAuditAll(env) : await readJson(env, entity);
  return new Response(JSON.stringify(data), { status: 200, headers: { "Content-Type": "application/json" } });
}

async function handlePost(req, env, entity) {
  if (entity === "audit") {
    return new Response(JSON.stringify({ error: "audit is append-only via other actions" }), { status: 400 });
  }
  const user = await requireSession(req, env);
  const idField = ID_FIELD[entity];
  if (!idField) return new Response(JSON.stringify({ error: "Unknown entity: " + entity }), { status: 400 });

  const body = await req.json().catch(() => ({}));
  const record = body.record;
  const action = body.action; // 'create' | 'update' | 'delete'
  if (!record || !action) return new Response(JSON.stringify({ error: "record and action are required" }), { status: 400 });
  if (action !== "create" && action !== "update" && action !== "delete") {
    return new Response(JSON.stringify({ error: "action must be create/update/delete" }), { status: 400 });
  }

  // required-field rule for brand-new leads only: email + phone + website.
  // Does NOT apply to "update" -- that covers partial patches (a note, a
  // status change, an attachment, insurance details) which legitimately
  // don't carry contact fields; full-edit validation already happens
  // client-side in the Edit-lead modal before it calls this endpoint.
  if (entity === "leads" && action === "create") {
    if (!record.em || !record.ph || !record.w) {
      return new Response(JSON.stringify({ error: "Email, phone, and website are all required." }), { status: 422 });
    }
  }

  let summary = null, logIt = true;
  if (entity === "leads") {
    // Split storage: every update/delete is written as an overlay into the
    // small "leads_dynamic" blob (merged over leads_static on read), so edits
    // never parse or rewrite the ~1.5 MB static blob. Only "create" does a
    // full read+rewrite -- which also folds any overlays back into static.
    const leadName = record._n, leadBefore = record._before || {};
    delete record._n; delete record._before; delete record.sh;   // status history is written here only
    const patch = action === "delete" ? { deleted: true } : record;
    if (action !== "create") {
      const found = await writeLeadsDynamicPatch(env, record[idField], patch, (prev) => {
        const name = leadName || prev.n || "Lead #" + record[idField];
        if (action !== "delete" && patch.st) {   // one entry per status change, dated in California time (contacted-per-day report)
          const was = Object.assign({}, leadBefore, prev);
          if (patch.st !== (was.st || "new")) {
            const day = new Date().toLocaleDateString("en-CA", { timeZone: "America/Los_Angeles" });
            const hist = Array.isArray(prev.sh) ? prev.sh.slice()
              : was.st && was.st !== "new" && was.sd ? [{ s: was.st, d: String(was.sd).slice(0, 10), by: was.sa || "" }] : [];
            hist.push({ s: patch.st, d: day, by: user.name || "" });
            patch.sh = hist.slice(-40); patch.sd = day;
          }
        }
        if (action === "delete") { summary = name + ": hidden from the list"; return; }
        const changes = describeChanges(Object.assign({}, leadBefore, prev), patch);
        // Lead saves are always stored (never risk losing one); only real changes are logged.
        if (!changes.length) { logIt = false; return; }
        summary = name + ": " + changes.join("; ");
        if (summary.length > 900) summary = summary.slice(0, 897) + "...";
      });
      if (!found) return new Response(JSON.stringify({ error: "Record not found" }), { status: 404 });
    } else {
      const list = await readLeads(env);
      const idx = list.findIndex((x) => String(x[idField]) === String(record[idField]));
      if (action === "create") {
        if (record[idField] == null || record[idField] === "") {
          record[idField] = entity + "-" + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
        }
        list.push(record);
      } else {
        if (idx === -1) return new Response(JSON.stringify({ error: "Record not found" }), { status: 404 });
        list[idx] = Object.assign({}, list[idx], patch);
      }
      await writeLeadsSplit(env, list);
      summary = "New lead \"" + (record.n || "") + "\" added (email " + (record.em || "-") + ", phone " + (record.ph || "-") + ", website " + (record.w || "-") + ")";
    }
  } else {
    summary = null;
    const list = await readJson(env, entity);
    const idx = list.findIndex((x) => String(x[idField]) === String(record[idField]));
    const before = idx === -1 ? null : Object.assign({}, list[idx]);

    // Tasks: team leaders (admin / super admin) add, assign, edit and delete. Agents may
    // only close their own tasks and write the agent note -- enforced here, not just in the UI.
    let rec = record;
    if (entity === "tasks" && user.role !== "admin" && user.role !== "superadmin") {
      if (action !== "update") return new Response(JSON.stringify({ error: "Only team leaders can add or delete tasks." }), { status: 403 });
      if (idx === -1) return new Response(JSON.stringify({ error: "Record not found" }), { status: 404 });
      if (String(list[idx].assignee || "") !== String(user.name || "")) {
        return new Response(JSON.stringify({ error: "You can only update tasks assigned to you." }), { status: 403 });
      }
      rec = { [idField]: record[idField] };
      ["completed", "completedAt", "agentNote"].forEach((k) => { if (k in record) rec[k] = record[k]; });
    }
    // Insurance directory: leaders edit everything; agents only the status, latest update and notes of their own rows.
    if (entity === "insdir" && user.role !== "admin" && user.role !== "superadmin") {
      if (action !== "update") return new Response(JSON.stringify({ error: "Only team leaders can add or delete directory rows." }), { status: 403 });
      if (idx === -1) return new Response(JSON.stringify({ error: "Record not found" }), { status: 404 });
      if (String(list[idx].agent || "") !== String(user.name || "")) {
        return new Response(JSON.stringify({ error: "You can only update organizations assigned to you." }), { status: 403 });
      }
      rec = { [idField]: record[idField] };
      ["status", "upd", "notes"].forEach((k) => { if (k in record) rec[k] = record[k]; });
    }

    if (action === "create") {
      if (record[idField] == null || record[idField] === "") {
        record[idField] = entity + "-" + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
      }
      list.push(record);
      summary = recordLabel(entity, record) + " created" +
        (entity === "tasks" ? (record.deadline ? ", deadline " + record.deadline : "") + (record.priority ? ", priority " + record.priority : "") : "");
    } else if (action === "update") {
      if (idx === -1) return new Response(JSON.stringify({ error: "Record not found" }), { status: 404 });
      const changes = describeChanges(before, rec);
      // A repeated click or an unchanged form: nothing to store, nothing to log.
      if (!changes.length) return new Response(JSON.stringify({ ok: true, id: record[idField], unchanged: true }), { status: 200, headers: { "Content-Type": "application/json" } });
      summary = (recordLabel(entity, before) || String(record[idField])) + ": " + changes.join("; ");
      if (summary.length > 900) summary = summary.slice(0, 897) + "...";
      list[idx] = Object.assign({}, list[idx], rec);
    } else if (action === "delete") {
      if (idx === -1) return new Response(JSON.stringify({ error: "Record not found" }), { status: 404 });
      list[idx].deleted = true; // soft delete -- audit trail keeps history
