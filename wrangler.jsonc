{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apa-credentialing-local",
  "main": "src/index.js",
  "compatibility_date": "2026-11-11",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "kv_namespaces": [
    {
      "binding": "APA_KV",
      "id": "00000000000000000000000000000000"
    }
  ]
}
